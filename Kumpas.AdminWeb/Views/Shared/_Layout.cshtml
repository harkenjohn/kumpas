<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KUMPAS Admin</title>
    <link rel="icon" type="image/png" href="~/images/kumpas-logo.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@{
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var adminName = User.Identity?.Name ?? "Admin";
    var adminInitial = string.IsNullOrWhiteSpace(adminName) ? "A" : adminName.Trim()[0].ToString().ToUpperInvariant();
    var pageDescription = ViewData["Description"]?.ToString();
}
@if (!isAuthenticated)
{
    <main class="auth-shell">
        @RenderBody()
    </main>
}
else
{
    <div class="app-shell">
        <aside class="sidebar">
            <div class="brand-block">
                <img src="~/images/kumpas-logo.png" alt="KUMPAS logo" class="brand-logo" />
                <span class="brand-kicker">KUMPAS</span>
                <h1>Admin System</h1>
                <p>Bidirectional sign and speech management.</p>
            </div>

            <nav class="sidebar-nav">
                <a asp-controller="Dashboard" asp-action="Index" class="nav-chip @(currentController == "Dashboard" ? "active" : "")">Dashboard</a>
                <a asp-controller="Accounts" asp-action="Index" class="nav-chip @(currentController == "Accounts" ? "active" : "")">Manage Accounts</a>
                <a asp-controller="Conversations" asp-action="Index" class="nav-chip @(currentController == "Conversations" ? "active" : "")">Conversation History</a>
                <a asp-controller="Reports" asp-action="Index" class="nav-chip @(currentController == "Reports" ? "active" : "")">Reports</a>
            </nav>
        </aside>

        <div class="main-shell">
            <header class="topbar">
                <div>
                    <span class="page-overline">@ViewData["Section"]</span>
                    <h2>@ViewData["Title"]</h2>
                    @if (!string.IsNullOrWhiteSpace(pageDescription))
                    {
                        <p class="topbar-subtitle">@pageDescription</p>
                    }
                </div>

                <div class="topbar-actions">
                    <div class="dropdown admin-dropdown">
                        <button class="admin-pill admin-profile-button" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="admin-avatar">@adminInitial</span>
                            <span class="admin-profile-copy">
                                <span class="admin-name">@adminName</span>
                                <span class="admin-role">Administrator</span>
                            </span>
                            <span class="admin-chevron" aria-hidden="true">⌄</span>
                        </button>

                        <div class="dropdown-menu dropdown-menu-end admin-menu">
                            <a asp-controller="Settings" asp-action="Index" class="dropdown-item admin-menu-item">Edit Profile</a>
                            <div class="dropdown-divider"></div>
                            <form asp-controller="Auth" asp-action="Logout" method="post" class="admin-logout-form">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item admin-menu-item admin-menu-logout">Logout</button>
                            </form>
                        </div>
                    </div>
                </div>
            </header>

            <main class="content-shell">
                @if (TempData["StatusMessage"] is string statusMessage)
                {
                    <div class="alert alert-success soft-alert">@statusMessage</div>
                }

                @if (TempData["ErrorMessage"] is string errorMessage)
                {
                    <div class="alert alert-danger soft-alert">@errorMessage</div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <div class="confirm-modal-backdrop" id="confirmModal" hidden>
        <div class="confirm-modal-card" role="dialog" aria-modal="true" aria-labelledby="confirmModalTitle" aria-describedby="confirmModalMessage">
            <div class="confirm-modal-icon" aria-hidden="true">!</div>
            <h3 id="confirmModalTitle">Please confirm</h3>
            <p id="confirmModalMessage">Are you sure you want to continue?</p>
            <div class="confirm-modal-actions">
                <button type="button" class="btn btn-light confirm-cancel" id="confirmModalCancel">Cancel</button>
                <button type="button" class="btn btn-danger confirm-accept" id="confirmModalAccept">OK</button>
            </div>
        </div>
    </div>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
