@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    ViewData["Section"] = "System";
}

<section class="soft-card">
    <h3>Something went wrong</h3>
    <p class="text-muted mb-0">The request could not be completed.</p>
    @if (Model.ShowRequestId)
    {
        <p class="mt-3 mb-0"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }
</section>
