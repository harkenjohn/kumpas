@model Kumpas.AdminWeb.ViewModels.ReportsViewModel
@{
    ViewData["Title"] = "Reports";
    ViewData["Section"] = "Analytics";
}

<section class="soft-card">
    <form method="get" class="filter-grid">
        <div>
            <label class="form-label">Search User</label>
            <input name="search" value="@Model.Search" class="form-control" placeholder="Name or email" />
        </div>

        <div>
            <label class="form-label">From</label>
            <input type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>

        <div>
            <label class="form-label">To</label>
            <input type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>

        <div>
            <button class="btn btn-primary w-100" type="submit">Generate Report</button>
        </div>
    </form>
</section>

<section class="soft-card printable-report">
    <div class="soft-card-header">
        <div>
            <h3>System Report</h3>
            <p class="table-muted mb-0">Generated report summary for the selected filters.</p>
        </div>
        <button type="button" class="btn btn-outline-primary btn-sm no-print" onclick="window.print()">Print Report</button>
    </div>

    <div class="report-meta-grid">
        <article class="profile-info-card">
            <span class="detail-label">Generated By</span>
            <strong>@Model.GeneratedBy</strong>
        </article>

        <article class="profile-info-card">
            <span class="detail-label">Generated Date</span>
            <strong>@Model.GeneratedAt.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</strong>
        </article>

        <article class="profile-info-card">
            <span class="detail-label">Report Period</span>
            <strong>
                @(Model.FromDate?.ToString("MMM dd, yyyy") ?? "Last 30 days")
                -
                @(Model.ToDate?.ToString("MMM dd, yyyy") ?? "Today")
            </strong>
        </article>
    </div>

    <div class="print-report-grid">
        <article class="report-summary-card">
            <span class="detail-label">Number of Users</span>
            <strong>@Model.TotalAccounts</strong>
            <p class="table-muted mb-0">Active: @Model.ActiveAccounts / Inactive: @Model.InactiveAccounts</p>
        </article>

        <article class="report-summary-card">
            <span class="detail-label">Model Uptime Status</span>
            <p class="report-provider-text mb-0">Provider: @Model.ModelProvider</p>
            <p class="table-muted mb-0">Uptime: @Model.ModelUptimePercent.ToString("0.#")% for @Model.UptimeReportDate.ToString("MMM dd, yyyy")</p>
            <button type="button" class="btn btn-outline-primary btn-sm mt-2 no-print" data-toggle-uptime>
                View Uptime Graph
            </button>
        </article>

        <article class="report-summary-card">
            <span class="detail-label">Error Logs Report</span>
            <strong>@Model.ErrorLogsToday error@(Model.ErrorLogsToday == 1 ? string.Empty : "s") today</strong>
            <p class="table-muted mb-0">This month: @Model.ErrorLogsThisMonth / This year: @Model.ErrorLogsThisYear</p>
        </article>

        <article class="report-summary-card">
            <span class="detail-label">Number of Sessions</span>
            <strong>@Model.TotalSessions</strong>
            <p class="table-muted mb-0">Messages in period: @Model.TotalMessages</p>
        </article>
    </div>
</section>

<section class="soft-card uptime-graph-card no-print" id="model-uptime-graph" hidden>
    <div class="soft-card-header">
        <div>
            <h3>Model Uptime Graph</h3>
            <p class="table-muted mb-0">
                Hourly model status for @Model.UptimeReportDate.ToString("MMM dd, yyyy"). Each hour is up when all recorded entries are <strong>OK</strong>.
            </p>
        </div>
        <span class="badge-soft @(Model.ModelStatus == "OK" ? "success" : Model.ModelStatus == "No uptime data" ? "info" : "error")">
            @Model.ModelStatus
        </span>
    </div>

    <div class="uptime-graph" aria-label="Hourly model uptime graph">
        @foreach (var hour in Model.ModelUptimeHours)
        {
            var statusClass = hour.HasData ? hour.IsUp ? "up" : "down" : "empty";
            var barHeight = hour.HasData ? Math.Max(8, (int)hour.UptimePercent) : 8;

            <article class="uptime-hour @statusClass" title="@hour.Label - @hour.DisplayStatus">
                <div class="uptime-bar-wrap">
                    <div class="uptime-bar" style="height: @barHeight%"></div>
                </div>
                <span>@hour.Label</span>
                <small>@hour.DisplayStatus</small>
                <small>@hour.UpChecks/@hour.TotalChecks</small>
            </article>
        }
    </div>
</section>

<section class="stats-grid">
    <article class="stat-card">
        <span class="stat-label">Accounts</span>
        <span class="stat-value">@Model.TotalAccounts</span>
    </article>

    <article class="stat-card">
        <span class="stat-label">Active Accounts</span>
        <span class="stat-value">@Model.ActiveAccounts</span>
    </article>

    <article class="stat-card">
        <span class="stat-label">Sessions</span>
        <span class="stat-value">@Model.TotalSessions</span>
    </article>

    <article class="stat-card">
        <span class="stat-label">Messages</span>
        <span class="stat-value">@Model.TotalMessages</span>
    </article>
</section>

<section class="reports-grid">
    <article class="soft-card">
        <h3>Daily Usage</h3>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Sessions</th>
                    <th>Messages</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var row in Model.DailyUsage)
            {
                <tr>
                    <td>@row.Day</td>
                    <td>@row.Sessions</td>
                    <td>@row.Messages</td>
                </tr>
            }
            </tbody>
        </table>
    </article>

    <article class="soft-card">
        <div class="soft-card-header">
            <div>
                <h3>Top Users</h3>
                <p class="table-muted mb-0">Most active users in the selected period.</p>
            </div>
        </div>

        <table class="data-table">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Messages</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var row in Model.TopUsers)
            {
                <tr>
                    <td>
                        <strong>@row.UserName</strong><br />
                        <span class="table-muted">@row.Email</span>
                    </td>
                    <td>@row.MessageCount</td>
                </tr>
            }

            </tbody>
        </table>

        <partial name="_Pagination" model="Model.TopUsersPagination" />
    </article>

    <article class="soft-card">
        <h3>Message Types</h3>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var row in Model.MessageTypes)
            {
                <tr>
                    <td>@row.MessageType</td>
                    <td>@row.Total</td>
                </tr>
            }
            </tbody>
        </table>
    </article>
</section>
