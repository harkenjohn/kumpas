@model Kumpas.AdminWeb.ViewModels.ReportsViewModel
@{
    ViewData["Title"] = "Reports";
    ViewData["Section"] = "Analytics";
    ViewData["Description"] = "Comprehensive analytics and insights about your system.";

    var chartRows = Model.DailyUsage
        .OrderBy(x => x.Day)
        .TakeLast(7)
        .ToList();

    if (chartRows.Count == 0)
    {
        chartRows =
        [
            new DailyUsageRowViewModel
            {
                Day = DateOnly.FromDateTime(DateTime.Today),
                Sessions = 0,
                Messages = 0
            }
        ];
    }

    var tableRows = Model.DailyUsage
        .OrderByDescending(x => x.Day)
        .Take(14)
        .ToList();

    if (tableRows.Count == 0)
    {
        tableRows = chartRows
            .OrderByDescending(x => x.Day)
            .ToList();
    }

    var activePercent = Model.ActiveAccountPercent;
    var inactivePercent = Model.TotalAccounts == 0 ? 0m : Math.Round(Model.InactiveAccounts * 100m / Model.TotalAccounts, 1);
    var avgMessagesPerSession = Model.TotalSessions == 0 ? 0m : Math.Round(Model.TotalMessages / (decimal)Model.TotalSessions, 2);

    var sessionsMax = Math.Max(1, chartRows.Max(x => x.Sessions));
    var messagesMax = Math.Max(1, chartRows.Max(x => x.Messages));
    var lineWidth = 420m;
    var lineHeight = 180m;
    var stepX = chartRows.Count == 1 ? 0 : lineWidth / (chartRows.Count - 1);
    var sessionPoints = string.Join(" ", chartRows.Select((row, index) =>
        $"{Math.Round(index * stepX, 2).ToString(System.Globalization.CultureInfo.InvariantCulture)},{Math.Round(lineHeight - ((decimal)row.Sessions / sessionsMax) * (lineHeight - 18m) - 9m, 2).ToString(System.Globalization.CultureInfo.InvariantCulture)}"));
    var barSlotWidth = 420m / chartRows.Count;

    var donutRadius = 46m;
    var donutCircumference = 2m * (decimal)Math.PI * donutRadius;
    var activeArc = donutCircumference * activePercent / 100m;
    var inactiveArc = donutCircumference * inactivePercent / 100m;

    var messageTypeTotal = Model.MessageTypes.Sum(x => x.Total);
    var signCount = Model.MessageTypes.FirstOrDefault(x => x.MessageType.Contains("Sign", StringComparison.OrdinalIgnoreCase))?.Total ?? 0;
    var speechCount = Model.MessageTypes.FirstOrDefault(x => x.MessageType.Contains("Speech", StringComparison.OrdinalIgnoreCase))?.Total ?? 0;
    var signPercent = messageTypeTotal == 0 ? 0m : Math.Round(signCount * 100m / messageTypeTotal, 1);
    var speechPercent = messageTypeTotal == 0 ? 0m : Math.Round(speechCount * 100m / messageTypeTotal, 1);
    var signArc = donutCircumference * signPercent / 100m;
    var speechArc = donutCircumference * speechPercent / 100m;

    var sessionAxisLabels = Enumerable.Range(0, 5)
        .Select(index => (int)Math.Round(sessionsMax * (4 - index) / 4m, MidpointRounding.AwayFromZero))
        .ToList();
    var messageAxisLabels = Enumerable.Range(0, 6)
        .Select(index => (int)Math.Round(messagesMax * (5 - index) / 5m, MidpointRounding.AwayFromZero))
        .ToList();

    var sessionChange = Model.SessionChangePercent;
    var messageChange = Model.MessageChangePercent;
    var healthLabel = Model.ModelUptimePercent >= 100m ? "Healthy" : Model.ModelUptimePercent > 0 ? "Monitor" : "No Data";
}

<section class="soft-card reports-toolbar-card no-print">
    <div class="reports-toolbar-header">
        <div class="reports-toolbar-spacer"></div>

        <form method="get" class="reports-toolbar-actions reports-toolbar-actions-compact">
            <input type="hidden" name="search" value="@Model.Search" />

            <div class="reports-date-range-card">
                <div class="reports-date-range-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M7 4.5v3" />
                        <path d="M17 4.5v3" />
                        <path d="M5 8h14" />
                        <rect x="4.5" y="6.5" width="15" height="13" rx="2.5" />
                    </svg>
                </div>
                <div class="reports-date-range-fields">
                    <input type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control reports-date-input reports-date-input-joined" />
                    <span class="reports-date-separator">-</span>
                    <input type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control reports-date-input reports-date-input-joined" />
                </div>
                <div class="reports-date-range-caret" aria-hidden="true">
                    <svg viewBox="0 0 20 20" focusable="false">
                        <path d="m6 8 4 4 4-4" />
                    </svg>
                </div>
            </div>

            <div class="reports-toolbar-buttons">
                <button class="btn btn-primary reports-generate-button" type="submit">
                    <span>Generate Report</span>
                </button>

                <a class="btn btn-outline-primary reports-print-toolbar-button"
                   asp-action="Print"
                   asp-route-search="@Model.Search"
                   asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                   asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")">
                    <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                        <path d="M7.25 7.25v-2.5h9.5v2.5" />
                        <path d="M6.15 9.25h11.7A2.15 2.15 0 0 1 20 11.4v2.15H4v-2.15a2.15 2.15 0 0 1 2.15-2.15Z" />
                        <rect x="7" y="14.25" width="10" height="5.5" rx=".75" />
                        <path d="M9.15 16.35h5.7" />
                        <path d="M9.15 18h4.2" />
                        <circle cx="17.45" cy="11.4" r=".72" fill="currentColor" stroke="none" />
                    </svg>
                    <span>Print Report</span>
                </a>
            </div>
        </form>
    </div>
</section>

<section class="soft-card printable-report reports-dashboard-shell" id="printable-report">
    <div class="report-print-masthead">
        <div class="report-print-brand">
            <img src="~/images/kumpas-logo.png" alt="KUMPAS logo" class="report-print-logo" />
            <div>
                <span class="page-overline">KUMPAS Analytics</span>
                <h2>System Report</h2>
                <p class="table-muted mb-0">Generated report summary for the selected filters and live system data.</p>
            </div>
        </div>
        <div class="report-print-stamp">
            <span class="detail-label">Prepared On</span>
            <strong>@Model.GeneratedAt.ToString("MMM dd, yyyy hh:mm tt")</strong>
        </div>
    </div>

    <div class="report-hero-grid">
        <article class="report-hero-card users">
            <div class="report-hero-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false" class="report-hero-icon-filled">
                    <circle cx="12" cy="8.35" r="3.3" fill="currentColor" />
                    <circle cx="6.4" cy="9.15" r="2.2" fill="currentColor" opacity=".88" />
                    <circle cx="17.6" cy="9.15" r="2.2" fill="currentColor" opacity=".88" />
                    <path d="M6.65 18.95c0-2.95 2.34-5.25 5.35-5.25s5.35 2.3 5.35 5.25V19H6.65v-.05Z" fill="currentColor" />
                    <path d="M1.9 18.95c0-2 1.58-3.45 3.76-3.45 1.18 0 2.24.38 3 .98-.58.74-.95 1.63-1.08 2.47H1.9Z" fill="currentColor" opacity=".88" />
                    <path d="M22.1 18.95c0-2-1.58-3.45-3.76-3.45-1.18 0-2.24.38-3 .98.58.74.95 1.63 1.08 2.47h5.68Z" fill="currentColor" opacity=".88" />
                </svg>
            </div>
            <div class="report-hero-copy">
                <div class="report-hero-topline">
                    <span class="detail-label">Accounts</span>
                </div>
                <strong>@Model.TotalAccounts</strong>
                <p class="table-muted mb-0">Total registered accounts</p>
            </div>
        </article>

        <article class="report-hero-card active">
            <div class="report-hero-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false" class="report-hero-icon-filled">
                    <circle cx="10.15" cy="8.1" r="3.15" fill="currentColor" />
                    <path d="M4.8 18.85c0-2.88 2.18-5.08 5.35-5.08 3.12 0 5.28 2.2 5.28 5.08V19H4.8v-.15Z" fill="currentColor" />
                    <circle cx="17.9" cy="15.55" r="3.55" fill="currentColor" />
                    <path d="m16.38 15.58 1.05 1.04 2.38-2.42" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                </svg>
            </div>
            <div class="report-hero-copy">
                <div class="report-hero-topline">
                    <span class="detail-label">Active Accounts</span>
                </div>
                <strong>@Model.ActiveAccounts</strong>
                <p class="table-muted mb-0">@activePercent.ToString("0.#")% of total accounts</p>
            </div>
        </article>

        <article class="report-hero-card sessions">
            <div class="report-hero-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M5 16.5 9 12.5l2.9 2.9 5.6-5.6" />
                    <path d="M14.8 9.8h2.7v2.7" />
                    <circle cx="9" cy="12.5" r=".85" />
                    <circle cx="11.9" cy="15.4" r=".85" />
                    <circle cx="17.5" cy="9.8" r=".85" />
                </svg>
            </div>
            <div class="report-hero-copy">
                <div class="report-hero-topline">
                    <span class="detail-label">Sessions</span>
                </div>
                <strong>@Model.TotalSessions</strong>
                <p class="table-muted mb-0">Total sessions</p>
            </div>
        </article>

        <article class="report-hero-card messages">
            <div class="report-hero-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M6.4 7.6h11.2A1.9 1.9 0 0 1 19.5 9.5v4a1.9 1.9 0 0 1-1.9 1.9h-3.7l-2.5 1.9v-1.9H6.4a1.9 1.9 0 0 1-1.9-1.9v-4a1.9 1.9 0 0 1 1.9-1.9z" />
                    <path d="M8.4 10.8h7.2" />
                    <path d="M8.4 13h4.8" />
                </svg>
            </div>
            <div class="report-hero-copy">
                <div class="report-hero-topline">
                    <span class="detail-label">Messages</span>
                </div>
                <strong>@Model.TotalMessages</strong>
                <p class="table-muted mb-0">Avg. per session: @avgMessagesPerSession.ToString("0.##")</p>
            </div>
        </article>
    </div>

    <div class="report-meta-strip report-meta-strip-dense">
        <article class="report-meta-card report-meta-feature">
            <div class="report-meta-icon">
                <svg viewBox="0 0 24 24" focusable="false">
                    <circle cx="12" cy="8" r="3" />
                    <path d="M6 18c0-3 2.7-5 6-5s6 2 6 5" />
                </svg>
            </div>
            <div>
                <span class="detail-label">Generated By</span>
                <strong>@Model.GeneratedBy</strong>
            </div>
        </article>

        <article class="report-meta-card report-meta-feature">
            <div class="report-meta-icon">
                <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M7 4.5v3" />
                    <path d="M17 4.5v3" />
                    <path d="M5 8h14" />
                    <rect x="4.5" y="6.5" width="15" height="13" rx="2.5" />
                </svg>
            </div>
            <div>
                <span class="detail-label">Generated Date</span>
                <strong>@Model.GeneratedAt.ToString("MMM dd, yyyy hh:mm tt")</strong>
            </div>
        </article>

        <article class="report-meta-card report-meta-feature">
            <div class="report-meta-icon">
                <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M7 4.5v3" />
                    <path d="M17 4.5v3" />
                    <path d="M5 8h14" />
                    <rect x="4.5" y="6.5" width="15" height="13" rx="2.5" />
                </svg>
            </div>
            <div>
                <span class="detail-label">Report Period</span>
                <strong>@(Model.FromDate?.ToString("MMM dd, yyyy") ?? "Last 30 days") - @(Model.ToDate?.ToString("MMM dd, yyyy") ?? "Today")</strong>
            </div>
        </article>

        <article class="report-meta-card report-meta-feature report-meta-uptime">
            <div class="report-meta-icon">
                <svg viewBox="0 0 24 24" focusable="false">
                    <rect x="5" y="5.5" width="14" height="13" rx="2.5" />
                    <path d="M8 9h8" />
                    <path d="M8 12h5" />
                    <path d="M8 15h8" />
                </svg>
            </div>
            <div>
                <span class="detail-label">Model Uptime Status</span>
                <strong class="report-provider-text">@Model.ModelProvider</strong>
                <p class="table-muted mb-0">@Model.ModelUptimePercent.ToString("0.#")% uptime for @Model.UptimeReportDate.ToString("MMM dd, yyyy")</p>
                <button type="button" class="btn btn-outline-primary btn-sm mt-2 no-print" data-toggle-uptime>View Uptime Graph</button>
            </div>
            <span class="badge-soft success">@healthLabel</span>
        </article>

    </div>

    <div class="report-chart-grid report-chart-grid-primary">
        <article class="report-visual-card">
            <div class="report-visual-header">
                <h4>User Status Overview</h4>
            </div>
            <div class="report-status-overview">
                <div class="report-donut-wrap report-donut-wrap-large">
                    <svg viewBox="0 0 160 160" class="report-donut-chart report-donut-chart-large" aria-label="User status overview chart">
                        <circle cx="80" cy="80" r="46" class="report-donut-track" />
                        <circle cx="80" cy="80" r="46"
                                class="report-donut-active"
                                style="stroke-dasharray:@(activeArc.ToString(System.Globalization.CultureInfo.InvariantCulture)) @(donutCircumference.ToString(System.Globalization.CultureInfo.InvariantCulture));" />
                        <circle cx="80" cy="80" r="46"
                                class="report-donut-inactive"
                                style="stroke-dasharray:@(inactiveArc.ToString(System.Globalization.CultureInfo.InvariantCulture)) @(donutCircumference.ToString(System.Globalization.CultureInfo.InvariantCulture)); stroke-dashoffset:@((-activeArc).ToString(System.Globalization.CultureInfo.InvariantCulture));" />
                    </svg>
                    <div class="report-donut-center report-donut-center-white">
                        <strong>@activePercent.ToString("0.#")%</strong>
                        <span>Active</span>
                    </div>
                </div>

                <div class="report-status-side">
                    <div class="report-status-line">
                        <span><i class="legend-dot active"></i>Active Users</span>
                        <strong>@Model.ActiveAccounts (@activePercent.ToString("0.#")%)</strong>
                    </div>
                    <div class="report-status-line">
                        <span><i class="legend-dot inactive"></i>Inactive Users</span>
                        <strong>@Model.InactiveAccounts (@inactivePercent.ToString("0.#")%)</strong>
                    </div>
                    <p class="table-muted mb-0">Total Users: @Model.TotalAccounts</p>
                </div>
            </div>
        </article>

        <article class="report-visual-card">
            <div class="report-visual-header report-visual-header-inline">
                <h4>Sessions Over Time</h4>
                <span class="report-chart-chip">Daily</span>
            </div>
            <div class="report-chart-frame">
                <div class="report-chart-axis">
                    @foreach (var label in sessionAxisLabels)
                    {
                        <span>@label</span>
                    }
                </div>
                <div class="report-chart-canvas">
                    <svg viewBox="0 0 460 220" class="report-line-chart" aria-label="Sessions over time chart">
                        @for (var gridIndex = 0; gridIndex < sessionAxisLabels.Count; gridIndex++)
                        {
                            var y = 24m + (gridIndex * 40m);
                            <line x1="34" y1="@y.ToString(System.Globalization.CultureInfo.InvariantCulture)" x2="445" y2="@y.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="chart-grid-line" />
                        }
                        <line x1="34" y1="185" x2="445" y2="185" class="chart-axis" />
                        <line x1="34" y1="24" x2="34" y2="185" class="chart-axis" />
                        <polyline points="@sessionPoints" class="chart-line" transform="translate(34 0)" />
                        @foreach (var point in chartRows.Select((row, index) => new
                        {
                            X = 34m + (index * stepX),
                            Y = lineHeight - ((decimal)row.Sessions / sessionsMax) * (lineHeight - 18m) - 9m
                        }))
                        {
                            <circle cx="@point.X.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                    cy="@point.Y.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                    r="4.5"
                                    class="chart-point" />
                        }
                    </svg>
                    <div class="chart-label-row chart-label-row-wide">
                        @foreach (var row in chartRows)
                        {
                            <span>@row.Day.ToString("MMM d")</span>
                        }
                    </div>
                </div>
            </div>
        </article>

        <article class="report-visual-card">
            <div class="report-visual-header report-visual-header-inline">
                <h4>Messages Count</h4>
                <span class="report-chart-chip">Daily</span>
            </div>
            <div class="report-chart-frame">
                <div class="report-chart-axis report-chart-axis-wide">
                    @foreach (var label in messageAxisLabels)
                    {
                        <span>@label</span>
                    }
                </div>
                <div class="report-chart-canvas">
                    <svg viewBox="0 0 460 220" class="report-bar-chart" aria-label="Messages count chart">
                        @for (var gridIndex = 0; gridIndex < messageAxisLabels.Count; gridIndex++)
                        {
                            var y = 24m + (gridIndex * 32.2m);
                            <line x1="34" y1="@y.ToString(System.Globalization.CultureInfo.InvariantCulture)" x2="445" y2="@y.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="chart-grid-line" />
                        }
                        <line x1="34" y1="185" x2="445" y2="185" class="chart-axis" />
                        <line x1="34" y1="24" x2="34" y2="185" class="chart-axis" />
                        @foreach (var bar in chartRows.Select((row, index) => new
                        {
                            Row = row,
                            X = 45m + (index * barSlotWidth),
                            Width = Math.Max(22m, barSlotWidth - 18m),
                            Height = ((decimal)row.Messages / messagesMax) * 138m + 10m
                        }))
                        {
                            var barY = 185m - bar.Height;
                            <rect x="@bar.X.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                  y="@barY.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                  width="@bar.Width.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                  height="@bar.Height.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                  rx="9"
                                  class="chart-bar" />
                        }
                    </svg>
                    <div class="chart-label-row chart-label-row-wide">
                        @foreach (var row in chartRows)
                        {
                            <span>@row.Day.ToString("MMM d")</span>
                        }
                    </div>
                    <div class="chart-value-row chart-value-row-wide chart-value-row-strong">
                        @foreach (var row in chartRows)
                        {
                            <span>@row.Messages</span>
                        }
                    </div>
                </div>
            </div>
        </article>
    </div>

    <div class="report-chart-grid report-chart-grid-secondary">
        <article class="report-health-card" id="system-health-panel">
            <div class="report-visual-header report-visual-header-inline">
                <h4>System Health</h4>
            </div>

            <div class="report-health-metrics report-health-metrics-compact">
                <div class="report-health-pill healthy">@healthLabel</div>
                <div>
                    <span class="detail-label">System Status</span>
                    <strong>@healthLabel</strong>
                </div>
                <div>
                    <span class="detail-label">Uptime</span>
                    <strong>@Model.ModelUptimePercent.ToString("0.#")%</strong>
                </div>
                <div>
                    <span class="detail-label">Errors Today</span>
                    <strong>@Model.ErrorLogsToday</strong>
                </div>
                <div>
                    <span class="detail-label">Errors (Month / Year)</span>
                    <strong>@Model.ErrorLogsThisMonth / @Model.ErrorLogsThisYear</strong>
                </div>
            </div>

            <div class="report-health-uptime-copy">Hourly Uptime (@Model.UptimeReportDate.ToString("MMM dd, yyyy"))</div>
            <div class="uptime-graph uptime-graph-inline" id="model-uptime-graph" aria-label="Hourly model uptime graph">
                @foreach (var hour in Model.ModelUptimeHours)
                {
                    var statusClass = hour.HasData ? hour.IsUp ? "up" : "down" : "empty";
                    var barHeight = hour.HasData ? Math.Max(8, (int)hour.UptimePercent) : 8;

                    <article class="uptime-hour @statusClass" title="@hour.Label - @hour.DisplayStatus">
                        <div class="uptime-bar-wrap">
                            <div class="uptime-bar" style="height: @barHeight%"></div>
                        </div>
                        <span>@hour.Label</span>
                    </article>
                }
            </div>
            <div class="report-health-legend">
                <span><i class="legend-dot uptime-ok"></i>OK (Up)</span>
                <span><i class="legend-dot inactive"></i>No Data</span>
            </div>
        </article>

        <article class="report-detail-card">
            <div class="report-visual-header report-visual-header-inline">
                <h4>Top Users</h4>
                <a href="#report-all-users" class="btn btn-outline-primary btn-sm no-print">View All Users</a>
            </div>
            <p class="table-muted mb-0 report-inline-subtitle">Most active users in the selected period.</p>

            <div class="report-mini-table">
                <div class="report-mini-table-head">
                    <span>User</span>
                    <span>Messages</span>
                </div>
                @if (Model.TopUsers.Count == 0)
                {
                    <div class="report-mini-table-empty">No user activity found for this period.</div>
                }
                else
                {
                    @foreach (var row in Model.TopUsers.Take(4))
                    {
                        <div class="report-mini-table-row">
                            <span>
                                <strong>@row.UserName</strong>
                                <small>@row.Email</small>
                            </span>
                            <strong>@row.MessageCount</strong>
                        </div>
                    }
                }
            </div>
        </article>

        <article class="report-visual-card">
            <div class="report-visual-header report-visual-header-inline">
                <h4>Message Type Breakdown</h4>
                <a href="#report-daily-usage" class="btn btn-outline-primary btn-sm no-print">View All Types</a>
            </div>
            <div class="report-status-overview report-status-overview-breakdown">
                <div class="report-donut-wrap report-donut-wrap-breakdown">
                    <svg viewBox="0 0 160 160" class="report-donut-chart report-donut-chart-large" aria-label="Message type breakdown chart">
                        <circle cx="80" cy="80" r="46" class="report-donut-track" />
                        <circle cx="80" cy="80" r="46"
                                class="report-donut-sign"
                                style="stroke-dasharray:@(signArc.ToString(System.Globalization.CultureInfo.InvariantCulture)) @(donutCircumference.ToString(System.Globalization.CultureInfo.InvariantCulture));" />
                        <circle cx="80" cy="80" r="46"
                                class="report-donut-speech"
                                style="stroke-dasharray:@(speechArc.ToString(System.Globalization.CultureInfo.InvariantCulture)) @(donutCircumference.ToString(System.Globalization.CultureInfo.InvariantCulture)); stroke-dashoffset:@((-signArc).ToString(System.Globalization.CultureInfo.InvariantCulture));" />
                    </svg>
                    <div class="report-donut-center report-donut-center-white report-donut-center-breakdown">
                        <strong>@messageTypeTotal</strong>
                        <span>Total</span>
                    </div>
                </div>

                <div class="report-status-side">
                    <div class="report-status-line">
                        <span><i class="legend-dot sign"></i>Translated to Sign</span>
                        <strong>@signCount (@signPercent.ToString("0.#")%)</strong>
                    </div>
                    <div class="report-status-line">
                        <span><i class="legend-dot speech"></i>Translated to Speech</span>
                        <strong>@speechCount (@speechPercent.ToString("0.#")%)</strong>
                    </div>
                </div>
            </div>
        </article>
    </div>

    <article class="report-detail-card report-daily-card" id="report-daily-usage">
        <div class="report-visual-header">
            <h4>Daily Usage</h4>
            <p class="table-muted mb-0">All times are based on your local timezone. This report is auto-generated.</p>
        </div>

        <div class="report-daily-table-wrap">
            <table class="report-daily-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        @foreach (var row in tableRows)
                        {
                            <th>@row.Day.ToString("MMM d")</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th>Sessions</th>
                        @foreach (var row in tableRows)
                        {
                            <td>@row.Sessions</td>
                        }
                    </tr>
                    <tr>
                        <th>Messages</th>
                        @foreach (var row in tableRows)
                        {
                            <td>@row.Messages</td>
                        }
                    </tr>
                </tbody>
            </table>
        </div>
    </article>

    <article class="report-detail-card report-users-card" id="report-all-users">
        <div class="report-visual-header">
            <h4>All Top Users</h4>
            <p class="table-muted mb-0">Full ranked list for the selected report filters.</p>
        </div>

        <div class="report-mini-table report-mini-table-full">
            <div class="report-mini-table-head">
                <span>User</span>
                <span>Messages</span>
            </div>
            @if (Model.TopUsers.Count == 0)
            {
                <div class="report-mini-table-empty">No user activity found for this period.</div>
            }
            else
            {
                @foreach (var row in Model.TopUsers)
                {
                    <div class="report-mini-table-row">
                        <span>
                            <strong>@row.UserName</strong>
                            <small>@row.Email</small>
                        </span>
                        <strong>@row.MessageCount</strong>
                    </div>
                }
            }
        </div>

        <partial name="_Pagination" model="Model.TopUsersPagination" />
    </article>

    <div class="report-note-strip">
        All times are based on your local timezone. This report is auto-generated.
    </div>
</section>
