@model Kumpas.AdminWeb.ViewModels.ReportsViewModel
@{
    Layout = null;

    var orderedUsage = Model.DailyUsage.OrderByDescending(x => x.Day).ToList();
    var topUsers = Model.TopUsers.Take(5).ToList();
    var signCount = Model.MessageTypes.FirstOrDefault(x => x.MessageType.Contains("Sign", StringComparison.OrdinalIgnoreCase))?.Total ?? 0;
    var speechCount = Model.MessageTypes.FirstOrDefault(x => x.MessageType.Contains("Speech", StringComparison.OrdinalIgnoreCase))?.Total ?? 0;
    var messageTypeTotal = Model.MessageTypes.Sum(x => x.Total);
    var signPercent = messageTypeTotal == 0 ? 0m : Math.Round(signCount * 100m / messageTypeTotal, 1);
    var speechPercent = messageTypeTotal == 0 ? 0m : Math.Round(speechCount * 100m / messageTypeTotal, 1);
    var activePercent = Model.TotalAccounts == 0 ? 0m : Math.Round(Model.ActiveAccounts * 100m / Model.TotalAccounts, 1);
    var inactivePercent = Model.TotalAccounts == 0 ? 0m : Math.Round(Model.InactiveAccounts * 100m / Model.TotalAccounts, 1);
    var avgMessagesPerSession = Model.TotalSessions == 0 ? 0m : Math.Round(Model.TotalMessages / (decimal)Model.TotalSessions, 2);
    var healthLabel = Model.ModelUptimePercent >= 100m ? "Healthy" : Model.ModelUptimePercent > 0 ? "Monitor" : "No Data";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>System Report - KUMPAS Admin</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="report-print-page">
    <main class="pdf-report-shell">
        <header class="pdf-report-header">
            <div class="pdf-report-title-block">
                <div class="pdf-report-brand-row">
                    <img src="~/images/kumpas-logo.png" alt="KUMPAS logo" class="pdf-report-logo" />
                    <div>
                        <div class="pdf-report-brand">KUMPAS</div>
                        <div class="pdf-report-subtitle">A Computer Vision and Augmented Reality Sign Language 
                            and Speech Translation Mobile Application</div>
                    </div>
                </div>
                <h1>SYSTEM REPORT</h1>
            </div>
            <div class="pdf-report-meta">
                <div><span>Generated</span><strong>@Model.GeneratedAt.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</strong></div>
                <div><span>Report Period</span><strong>@(Model.FromDate?.ToString("MMM dd, yyyy") ?? "Last 30 days") - @(Model.ToDate?.ToString("MMM dd, yyyy") ?? "Today")</strong></div>
            </div>
        </header>

        <section class="pdf-report-section">
            <h2>Platform Overview</h2>
            <table class="pdf-report-table">
                <tbody>
                    <tr>
                        <th>Total Users</th>
                        <td>@Model.TotalAccounts</td>
                        <th>Active Users</th>
                        <td>@Model.ActiveAccounts (@activePercent.ToString("0.#")%)</td>
                    </tr>
                    <tr>
                        <th>Inactive Users</th>
                        <td>@Model.InactiveAccounts (@inactivePercent.ToString("0.#")%)</td>
                        <th>Generated By</th>
                        <td>@Model.GeneratedBy</td>
                    </tr>
                </tbody>
            </table>
        </section>

        <section class="pdf-report-section">
            <h2>Translation Activity</h2>
            <table class="pdf-report-table">
                <tbody>
                    <tr>
                        <th>Total Sessions</th>
                        <td>@Model.TotalSessions</td>
                        <th>Total Messages</th>
                        <td>@Model.TotalMessages</td>
                    </tr>
                    <tr>
                        <th>Average Messages per Session</th>
                        <td>@avgMessagesPerSession.ToString("0.##")</td>
                        <th>Model Provider</th>
                        <td>@Model.ModelProvider</td>
                    </tr>
                </tbody>
            </table>
        </section>

        <section class="pdf-report-grid">
            <article class="pdf-report-section">
                <h2>User Status Overview</h2>
                <table class="pdf-report-table">
                    <thead>
                        <tr>
                            <th>Status</th>
                            <th>Count</th>
                            <th>Percentage</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Active Users</td>
                            <td>@Model.ActiveAccounts</td>
                            <td>@activePercent.ToString("0.#")%</td>
                        </tr>
                        <tr>
                            <td>Inactive Users</td>
                            <td>@Model.InactiveAccounts</td>
                            <td>@inactivePercent.ToString("0.#")%</td>
                        </tr>
                    </tbody>
                </table>
            </article>

            <article class="pdf-report-section">
                <h2>Message Type Breakdown</h2>
                <table class="pdf-report-table">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Total</th>
                            <th>Percentage</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Translated to Sign</td>
                            <td>@signCount</td>
                            <td>@signPercent.ToString("0.#")%</td>
                        </tr>
                        <tr>
                            <td>Translated to Speech</td>
                            <td>@speechCount</td>
                            <td>@speechPercent.ToString("0.#")%</td>
                        </tr>
                    </tbody>
                </table>
            </article>
        </section>

        <section class="pdf-report-section">
            <h2>Top Users</h2>
            <table class="pdf-report-table">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Messages</th>
                    </tr>
                </thead>
                <tbody>
                    @if (topUsers.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="pdf-empty-cell">No user activity found for the selected period.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in topUsers)
                        {
                            <tr>
                                <td>@user.UserName</td>
                                <td>@user.Email</td>
                                <td>@user.MessageCount</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </section>

        <section class="pdf-report-section">
            <h2>Conversation Summary</h2>
            <table class="pdf-report-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Sessions</th>
                        <th>Messages</th>
                    </tr>
                </thead>
                <tbody>
                    @if (orderedUsage.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="pdf-empty-cell">No conversation data found for the selected period.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in orderedUsage.Take(10))
                        {
                            <tr>
                                <td>@row.Day.ToString("MMM dd, yyyy")</td>
                                <td>@row.Sessions</td>
                                <td>@row.Messages</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </section>

        <section class="pdf-report-grid">
            <article class="pdf-report-section">
                <h2>System Health</h2>
                <table class="pdf-report-table">
                    <tbody>
                        <tr>
                            <th>System Status</th>
                            <td>@healthLabel</td>
                            <th>Model Uptime</th>
                            <td>@Model.ModelUptimePercent.ToString("0.#")%</td>
                        </tr>
                        <tr>
                            <th>Errors Today</th>
                            <td>@Model.ErrorLogsToday</td>
                            <th>Errors (Month / Year)</th>
                            <td>@Model.ErrorLogsThisMonth / @Model.ErrorLogsThisYear</td>
                        </tr>
                    </tbody>
                </table>
            </article>

            <article class="pdf-report-section">
                <h2>Daily Usage Snapshot</h2>
                <table class="pdf-report-table">
                    <tbody>
                        <tr>
                            <th>Latest Sessions</th>
                            <td>@(orderedUsage.FirstOrDefault()?.Sessions ?? 0)</td>
                            <th>Latest Messages</th>
                            <td>@(orderedUsage.FirstOrDefault()?.Messages ?? 0)</td>
                        </tr>
                        <tr>
                            <th>Latest Date</th>
                            <td>@(orderedUsage.FirstOrDefault()?.Day.ToString("MMM dd, yyyy") ?? "-")</td>
                            <th>Total AR Models</th>
                            <td>@Model.TotalArModels</td>
                        </tr>
                    </tbody>
                </table>
            </article>
        </section>

        <section class="pdf-report-section">
            <h2>Model Uptime Graph</h2>
            <div class="pdf-uptime-grid">
                @foreach (var hour in Model.ModelUptimeHours)
                {
                    var statusClass = hour.HasData ? hour.IsUp ? "up" : "down" : "empty";
                    var barHeight = hour.HasData ? Math.Max(8, (int)hour.UptimePercent) : 8;

                    <article class="uptime-hour @statusClass">
                        <div class="uptime-bar-wrap">
                            <div class="uptime-bar" style="height: @barHeight%"></div>
                        </div>
                        <span>@hour.Label</span>
                    </article>
                }
            </div>
        </section>

        <footer class="pdf-report-footer">
            KUMPAS Admin System | System Report
        </footer>
    </main>

    <script>
        window.addEventListener("load", function () {
            window.print();
        });
    </script>
</body>
</html>
