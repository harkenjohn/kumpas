@model Kumpas.AdminWeb.ViewModels.LoginViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Login";
}

<section class="login-portal" aria-label="KUMPAS administrator login">
    <div class="login-portal-info">
        <div class="login-portal-logo-wrap">
            <img src="~/images/kumpas-logo.png" alt="KUMPAS logo" class="login-portal-logo" />
            <h1>KUMPAS</h1>
            <span>ADMIN PORTAL</span>
        </div>

        <div class="login-welcome-copy">
            <h2>Welcome Back!</h2>
            <p>Sign in with your active administrator account to access the KUMPAS web system.</p>
        </div>

        <div class="login-feature-list" aria-label="KUMPAS admin features">
            <div class="login-feature-item">
                <span class="login-feature-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M12 3.5 19 6v5.3c0 4.4-2.9 7.9-7 9.2-4.1-1.3-7-4.8-7-9.2V6l7-2.5Z" />
                        <path d="m8.9 12.1 2 2 4.4-4.5" />
                    </svg>
                </span>
                <div>
                    <strong>Secure Access</strong>
                    <small>Protected administrator login</small>
                </div>
            </div>
            <div class="login-feature-item">
                <span class="login-feature-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M12 12.2a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" />
                        <path d="M5 20.5c.7-3.7 3.1-5.6 7-5.6s6.3 1.9 7 5.6" />
                    </svg>
                </span>
                <div>
                    <strong>User Management</strong>
                    <small>Manage users and permissions</small>
                </div>
            </div>
            <div class="login-feature-item">
                <span class="login-feature-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M4.5 19.5h15" />
                        <path d="M6 17v-5h3.2v5" />
                        <path d="M10.4 17V8h3.2v9" />
                        <path d="M14.8 17v-6h3.2v6" />
                        <path d="M14.2 7.2h4.3v4.3" />
                        <path d="m13.5 11.2 5-5" />
                    </svg>
                </span>
                <div>
                    <strong>System Overview</strong>
                    <small>Insights and reports at a glance</small>
                </div>
            </div>
        </div>
    </div>

    <div class="login-portal-form">
        <div class="login-form-heading">
            <h2>Administrator Sign In</h2>
            <p>Please enter your credentials to continue</p>
        </div>

        <form asp-action="Login" method="post" class="login-grid">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div>
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" class="form-control login-input" placeholder="admin@kumpas.com" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control login-input" placeholder="Enter your password" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="login-options">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label">Keep me signed in</label>
                </div>
            </div>

            <button type="submit" class="btn btn-primary login-submit">Sign In</button>
        </form>

        <div class="login-authorized-note">
            <span>✓</span>
            <p>Only authorized administrators can access this system.</p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
