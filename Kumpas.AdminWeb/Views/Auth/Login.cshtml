@model Kumpas.AdminWeb.ViewModels.LoginViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Login";
}

<section class="login-card">
    <div class="login-brand">
        <span class="brand-kicker">KUMPAS</span>
        <h1>Admin Login</h1>
        <p class="text-muted mb-0">Sign in with your active administrator account to access the KUMPAS web system.</p>
    </div>

    <form asp-action="Login" method="post" class="login-grid">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div>
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" placeholder="admin@kumpas.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div>
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" placeholder="Enter your password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-check">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label">Keep me signed in</label>
        </div>

        <button type="submit" class="btn btn-primary w-100">Sign In</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
